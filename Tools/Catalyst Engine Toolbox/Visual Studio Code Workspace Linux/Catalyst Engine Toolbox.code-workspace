{
	"folders": [
		{
			"name" : "Workspace",
			"path" : "."
		},
		{
            "name": "Code",
            "path": "../Code"
        }
	],
    "settings": {
        "clangd.arguments": [
            "--compile-commands-dir=${workspaceFolder}/Build"
        ],
        "debug.allowBreakpointsEverywhere": true,
        "cmake.options.statusBarVisibility": "visible",
        "cmake.sourceDirectory": "${workspaceFolder}",
        "cmake.autoSelectActiveFolder": false
    }
}